    "dev:vite:mocked": "cross-env MOCKED_REQUESTS=true NODE_ENV=development vite serve",
    "clean": "rm -rf dist",
    "test": "jest --maxWorkers 2 --no-cache --passWithNoTests",
    "lint": "eslint --ext .js,.jsx,.ts,.tsx,.json src",
    "format": "prettier src --write",
    "commit": "npx cz-customizable",
    "commit:retry": "npx cz-customizable --retry",
    "cm": "npx cz-customizable",
    "cm:retry": "npx cz-customizable --retry",
