  "info": { "title": "SUM RM API", "description": "", "version": "1.0", "contact": {} },
  "tags": [],
  "servers": [],
  "components": {
    "schemas": {
      "ModelCreateDto": {
        "type": "object",
        "properties": {
          "artefact_tech_label": { "type": "string", "example": "record_id" },
          "artefact_value_id": { "type": "number", "nullable": true, "example": null },
          "artefact_string_value": { "type": "string", "example": "new value" }
        },
        "required": ["artefact_tech_label", "artefact_value_id", "artefact_string_value"]
      },
      "ArtefactDto": {
        "type": "object",
        "properties": {
          "artefact_tech_label": { "type": "string", "example": "record_id" },
          "artefact_value_id": { "type": "number", "nullable": true, "example": null },
          "artefact_string_value": { "type": "string", "example": "new value" }
        },
        "required": ["artefact_tech_label", "artefact_value_id", "artefact_string_value"]
      },
      "ModelsUpdateDto": {
        "type": "object",
        "properties": {
          "model_id": {
            "type": "string",
            "example": "3009b53c-507d-11ed-9b68-0a5801020704",
            "format": "uuid"
          },
          "artefacts": { "$ref": "#/components/schemas/ArtefactDto" }
        },
        "required": ["model_id", "artefacts"]
      },
      "TemplateCreateDto": {
        "type": "object",
        "properties": {
          "template_name": { "type": "string", "example": "Название шаблона" },
          "public": { "type": "boolean", "example": true },
          "filterModel": {
            "type": "object",
            "example": {
              "record_id": { "values": ["value1", "value2"], "filterType": "set" },
              "created_date": {
                "dateFrom": "2024-01-01",
                "dateTo": "2024-12-31",
                "filterType": "date",
                "type": "inRange"
              }
            }
          },
          "sortState": {
            "example": [{ "colId": "record_id", "sort": "asc", "sortIndex": 0 }],
            "type": "array",
            "items": { "type": "string" }
          },
          "columnState": {
