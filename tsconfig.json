{
  "include": ["src"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@entities": ["./src/entities"],
      "@entities/*": ["./src/entities/*"],
      "@pages": ["./src/pages/"],
      "@pages/*": ["./src/pages/*"],
      "@src/*": ["./src/*"],
      "@src": ["./src"],
      "@app": ["./src/app"],
      "@app/*": ["./src/app/*"],
      "@widgets": ["./src/widgets/"],
      "@widgets/*": ["./src/widgets/*"],
      "@features": ["./src/features/"],
      "@features/*": ["./src/features/*"],
      "@shared/*": ["./src/shared/*"],
      "@shared": ["./src/shared"],
      "zustand": ["./external_modules/zustand/src/*"],
      "zustand/*": ["./external_modules/zustand/src/*"],
      "use-sync-external-store": ["./external_modules/use-sync-external-store"],
      "use-sync-external-store/*": ["./external_modules/use-sync-external-store"]
    },
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "es2017"],
    "allowJs": true,
    "sourceMap": true,
    "jsx": "react-jsx",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"]
}

