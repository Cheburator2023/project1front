{
  "include": ["src"],
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@entities": ["src/entities/*", "src/entities/"],
      "@pages": ["src/pages/*", "src/pages/"],
      "@src/*": ["src/*"],
      "@app/*": ["src/app/*"],
      "@widgets/*": ["src/widgets/*"],
      "@features": ["src/features/*", "src/features/"],
      "@shared/*": ["src/shared/*"],
      "*": ["./src/*"],
    },
    "target": "esnext",
    "module": "esnext",
    "lib": ["dom", "es2017"],
    "allowJs": true,
    "sourceMap": true,
    "jsx": "react",
    "strict": true,
    "moduleResolution": "node",
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "noEmit": true,
    "skipLibCheck": true
  },
  "exclude": ["node_modules", "dist"]
}
